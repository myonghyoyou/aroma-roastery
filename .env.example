# Notion internal integration secret (starts with ntn_ or secret_). Never commit the real value.
NOTION_TOKEN=
# Filled in after setup: the two Notion databases the site reads
NOTION_POSTS_DB=
NOTION_SETTINGS_DB=

# Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# must equal the redirect URL registered in the Meta app
INSTAGRAM_REDIRECT_URI=https://www.aroma-roastery.com/api/instagram/callback
# optional: refuse to connect any other account than this one
INSTAGRAM_USERNAME=
# optional: a token set by hand; normally the token comes from /api/instagram/connect and is kept in Redis
INSTAGRAM_TOKEN=
# Upstash Redis (Vercel Storage) where the token is kept and renewed; set by the Vercel integration
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel sends it with the daily renewal cron
CRON_SECRET=
