# Notion internal integration secret (starts with ntn_ or secret_). Never commit the real value.
NOTION_TOKEN=
# Filled in after setup: the two Notion databases the site reads
NOTION_POSTS_DB=
NOTION_SETTINGS_DB=

# Instagram API with Instagram Login: long-lived token of the store account (business or creator).
# Without it the archive shows the sample feed (src/lib/mock-instagram.ts).
INSTAGRAM_TOKEN=
